{
  "version": 2,
  "functions": {
    "api/main.py": {
      "runtime": "@vercel/python@3.13.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "installCommand": "pip install -r ./backend/requirements.txt && npm install",
  "buildCommand": "npm run build"
}
